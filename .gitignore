# WordPress core — never commit; only the theme is ours
/wordpress/
/wp-admin/
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-activate.php
/wp-blog-header.php
/wp-comments-post.php
/wp-config-sample.php
/wp-cron.php
/wp-links-opml.php
/wp-load.php
/wp-login.php
/wp-mail.php
/wp-settings.php
/wp-signup.php
/wp-trackback.php
/xmlrpc.php
wp-config.php
wp-config-local.php

# Uploads and cache
/wp-content/uploads/
/wp-content/cache/
/wp-content/upgrade/
/wp-content/backup*/
/wp-content/index.php

# Plugins are installed, not vendored (cap: 3 — see CONTEXT.md §4)
/wp-content/plugins/

# Must-use plugins are LOCAL DEV ONLY and must never reach the server.
# zz-devlogin.php in here is a password-free sign-in by query string; the file
# header claimed this directory was already ignored and it was not, so the
# backdoor was one `git add -A` from being committed.
/wp-content/mu-plugins/

# Bundled default themes — only our theme is tracked
/wp-content/themes/*
!/wp-content/themes/jbnewgen/

# Secrets
.env
.env.local
*.key
*.pem

# Local WordPress dev environments
/local/
/.localwp/
/.wp-local/
*.sql
*.sql.gz

# Graphify output
/graphify-out/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Claude local overrides
.claude/settings.local.json

# Debug log — it records every mail subject, and our sign-in emails put the
# six-digit code in the subject line. Never commit it.
/wp-content/debug.log

# Graphify index for this repo — a local, regenerable artifact, and large.
/wp-content/themes/jbnewgen/graphify-out/

# Local UI screenshots used while iterating on the admin.
/.preview/

# CSS build tooling. The theme ships the COMPILED assets/site.css; npm exists
# only on a developer machine and never reaches the server (the deploy branch
# is a subtree of the theme, so nothing at the repo root is published).
/node_modules/
/package-lock.json
